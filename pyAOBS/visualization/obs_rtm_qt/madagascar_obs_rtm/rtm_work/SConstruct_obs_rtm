# -*- coding: utf-8 -*-
"""AUTO-GENERATED by pyAOBS obs_rtm_qt — OBS-as-source (reciprocal) RTM."""
# Inputs: ../vel.rsf ../shots*/ + prebuilt obs_gath_*/rec_shots
# Mode: sou=OBS, rec=selected shots; 2×awefd2d per OBS
from rsf.proj import *
import os
import sys

par = dict(
    oz=0, dz=0.25, nz=241,
    ox=0, dx=0.5, nx=821,
    ot=0.0, dt=0.004, nt=7501,
    fmin=5, fmax=12, fm=8.5, kt=29,
    nb=40, jsnap=80, vwater=1.5,
    apply_bp=False, apply_mute=False,
    tmute=1, vmute=6, mute_tp=0.15, mute_inner=False,
    verb='n',
)
par['zmax'] = 60
par['xmax'] = 410
print('OBS-as-source RTM: nx={nx} nz={nz} nt={nt} jsnap={jsnap} ~{nsnap} snaps/OBS n_obs={nobs} n_rec_shots={nrec} verb={verb}'.format(nx=par['nx'], nz=par['nz'], nt=par['nt'], jsnap=par['jsnap'], nsnap=93, nobs=1, nrec=49, verb=par['verb']), flush=True)
VEL = '../vel.rsf'
REC_SHOTS = 'rec_shots.rsf'  # selected surface shots as receivers
BATH2D_FROM = '../bath1d.rsf'
_SMOOTH = 0
OBS_JOBS = [(0, 'obs_gath_000.rsf', 345.626, 1.901)]

if _SMOOTH > 0:
    Flow('vels', VEL, 'smooth rect1=%d rect2=%d repeat=1' % (_SMOOTH, _SMOOTH))
else:
    Flow('vels', VEL, 'window')
Flow('den', 'vels', 'math output=1')

Flow('bath2d', BATH2D_FROM,     'spray axis=1 n=%(nz)d o=%(oz)g d=%(dz)g | put label1=Depth unit1=km label2=Distance unit2=km' % par)

Flow('wav', None,     'spike nsp=1 n1=%(nt)d d1=%(dt)g o1=%(ot)g k1=%(kt)d | ricker1 frequency=%(fm)g | scale axis=1 | transp' % par)

img_names = []
for iobs, gather, xo, zo in OBS_JOBS:
    tag = '%03d' % int(iobs)
    print('>>> schedule OBS', tag, 'as SOURCE x=%.3f z=%.3f' % (xo, zo), flush=True)
    Flow('xs_obs_' + tag, None, 'math n1=1 output=%g' % float(xo))
    Flow('zs_obs_' + tag, None, 'math n1=1 output=%g' % max(float(zo), 1e-4))
    Flow('ss_obs_' + tag, ['xs_obs_' + tag, 'zs_obs_' + tag],         'cat axis=2 space=n ${SOURCES[0]} ${SOURCES[1]} | transp', stdin=0)
    Flow('raw_' + tag, gather, 'window')
    if par['apply_bp']:
        Flow('bp_' + tag, 'raw_' + tag,             'bandpass fhi=%(fmax)g flo=%(fmin)g' % par)
    else:
        Flow('bp_' + tag, 'raw_' + tag, 'window')
    # mute：由 GUI 拼 obs_gath 时 Python 预应用（相对 OBS）；此处不再 mutter
    if par['apply_mute']:
        Flow('mut_' + tag, 'bp_' + tag,             'mutter x0=0 half=n t0=%g tp=%g abs=y v0=%g inner=%s' % (par['tmute'], par.get('mute_tp', 0.15), par['vmute'], 'y' if par.get('mute_inner', True) else 'n'))
    else:
        Flow('mut_' + tag, 'bp_' + tag, 'window')
    Flow('mut_t_' + tag, 'mut_' + tag, 'window n1=%(nt)d' % par)
    print('>>> awefd2d FORWARD OBS', tag, '(sou=OBS, rec=shots, expl=y)', flush=True)
    Flow(['datf_' + tag, 'wfls_' + tag],         ['wav', 'vels', 'den', 'ss_obs_' + tag, REC_SHOTS],         'awefd2d vel=${SOURCES[1]} den=${SOURCES[2]} sou=${SOURCES[3]} rec=${SOURCES[4]} wfl=${TARGETS[1]} verb=%(verb)s free=y expl=y dabc=y nb=%(nb)d snap=y jsnap=%(jsnap)d jdata=1' % par)
    print('>>> awefd2d FORWARD done OBS', tag, flush=True)
    Flow('dat_adj_' + tag, 'mut_t_' + tag, 'transp')
    print('>>> awefd2d ADJOINT OBS', tag, '(sou=shots 注入反传, expl=n；awefd2d 始终在 sou 注入)', flush=True)
    Flow(['datb_' + tag, 'wflr_' + tag],         ['dat_adj_' + tag, 'vels', 'den', REC_SHOTS, 'ss_obs_' + tag],         'awefd2d adj=y vel=${SOURCES[1]} den=${SOURCES[2]} sou=${SOURCES[3]} rec=${SOURCES[4]} wfl=${TARGETS[1]} verb=%(verb)s free=y expl=n dabc=y nb=%(nb)d snap=y jsnap=%(jsnap)d jdata=1' % par)
    print('>>> awefd2d ADJOINT done OBS', tag, flush=True)
    Flow('img_obs_' + tag, ['wfls_' + tag, 'wflr_' + tag],         'add ${SOURCES[1]} mode=p | stack axis=3 norm=n')
    img_names.append('img_obs_' + tag)

if not img_names:
    raise RuntimeError('no OBS jobs scheduled')

import glob as _glob
import os as _os
import re as _re
_disk_obs = []
for _p in _glob.glob('img_obs_*.rsf'):
    if _p.endswith('.rsf@'):
        continue
    _m = _re.match(r'img_obs_(\d+)\.rsf$', _os.path.basename(_p))
    if _m:
        _disk_obs.append('img_obs_%03d' % int(_m.group(1)))
_stack_src = sorted(set(_disk_obs) | set(img_names), key=lambda s: int(s.rsplit('_', 1)[-1]))
print('>>> stack OBS images:', ','.join(_stack_src), '(disk+this run)', flush=True)
if len(_stack_src) == 1:
    Flow('img_stack', _stack_src[0], 'cp')
else:
    Flow('img_stack', _stack_src, 'add ${SOURCES[1:%d]}' % len(_stack_src))
Flow('img_solid', 'img_stack bath2d',     "math b=${SOURCES[1]} output='input*0.5*(1+sign(x1-b))'")
Flow('img_lap', 'img_solid', 'laplac')
End()
